APP_NAME="Gestor de contactos"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8080
APP_TIMEZONE=America/Panama

APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_ES

APP_MAINTENANCE_DRIVER=file
PHP_CLI_SERVER_WORKERS=4
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=gestor
DB_USERNAME=gestor
DB_PASSWORD=secret

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database
CACHE_PREFIX=

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hola@gestordecontactos.test"
MAIL_FROM_NAME="${APP_NAME}"

# Demo pública: cuentas semilla, límites y reset nocturno.
DEMO_MODE=false
DEMO_RESET_AT=03:00
DEMO_PASSWORD=demo1234
DEMO_ADMIN_EMAIL=admin@gestordecontactos.test
DEMO_VIEWER_EMAIL=lector@gestordecontactos.test
DEMO_EDITOR_EMAIL=editor@gestordecontactos.test
DEMO_MAX_UPLOAD_KB=2048
DEMO_MAX_IMPORT_ROWS=500

# Importación y exportación.
IMPORT_QUEUE_THRESHOLD=5000
IMPORT_MAX_ROWS=50000
IMPORT_MAX_FILE_KB=10240
EXPORT_MAX_ROWS=20000

VITE_APP_NAME="${APP_NAME}"
